{{!< default}}
{{> "components/header" headerStyle=@custom.header_style}}

<section class="ss-grid-container">
  <div class="ss-grid-main">
    {{#get "posts" filter="tag:featured+ -tag:opinion+ -tag:op-ed+ -tag:letters+ -tag:editorial+ -tag:interview" limit="6" include="authors,tags"}}
    <section class="ss-section ss-section-featured">
      <div class="ss-slider" data-slider="featured">
        <div class="ss-slider-wrapper">
          {{#foreach posts}}
            <div class="ss-slider-item"><a href="{{url}}">{{#if feature_image}}<img src="{{img_url feature_image size='l'}}" alt="{{title}}">{{/if}}<div class="ss-slider-item-content"><h2 class="ss-slider-item-title">{{title}}</h2></div></a></div>
          {{/foreach}}
        </div>
        <button class="ss-slider-prev">&lt;</button><button class="ss-slider-next">&gt;</button>
      </div>
    </section>
    {{/get}}

    {{#get "posts" filter="-tag:opinion+ -tag:op-ed+ -tag:letters+ -tag:editorial+ -tag:interview" limit="8"}}
    <section class="ss-section ss-section-latest"><h3 class="ss-section-title">Latest News</h3><ul class="ss-post-list-simple">{{#foreach posts}}<li><a href="{{url}}">{{title}}</a></li>{{/foreach}}</ul></section>
    {{/get}}
  </div>

  <aside class="ss-grid-sidebar">
    {{#get "posts" filter="tag:opinion" limit="5" include="authors"}}
    <section class="ss-section ss-section-sidebar"><h3 class="ss-section-title">Opinion</h3><div class="ss-post-list-sidebar">{{#foreach posts}}<article class="ss-post-item-sidebar">{{#if feature_image}}<a href="{{url}}" class="ss-post-item-sidebar-img"><img src="{{img_url feature_image size='s'}}" alt="{{title}}"></a>{{/if}}<div class="ss-post-item-sidebar-content"><h4 class="ss-post-item-sidebar-title"><a href="{{url}}">{{title}}</a></h4><span class="ss-post-item-sidebar-author">{{#if primary_author}}{{primary_author.name}}{{/if}}</span></div></article>{{/foreach}}</div></section>
    {{/get}}
  </aside>
</section>

{{!-- Photo Stories --}}
{{#get "posts" filter="tag:photo-stories" limit="8" include="tags"}}
<section class="ss-section-fullwidth ss-section-photostories"><div class="ss-grid-container"><h3 class="ss-section-title">Photo Stories</h3></div><div class="ss-slider" data-slider="photostories"><div class="ss-slider-wrapper">{{#foreach posts}}<div class="ss-slider-item-photo"><a href="{{url}}">{{#if feature_image}}<img src="{{img_url feature_image size='m'}}' alt='{{title}}'>{{/if}}<div class="ss-slider-item-content"><h4 class="ss-slider-item-title-photo">{{title}}</h4></div></a></div>{{/foreach}}</div><button class="ss-slider-prev">&lt;</button><button class="ss-slider-next">&gt;</button></div></section>
{{/get}}

{{> "components/footer"}}